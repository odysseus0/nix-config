# Mocha, not Frappe: Frappe is the deliberately soft flavor, and the accents
# need to stay separable now that agent state is read at a glance. It also
# matches herdr, which ships a single dark Catppuccin (no flavor variants).
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
keybind = shift+enter=text:\n
macos-option-as-alt = true

# Font configuration (from Mitchell's setup)
font-family = JetBrains Mono Nerd Font
font-size = 14