index 0000000..8e0c874
--- /dev/null
+++ b/mlx_qwen3_asr/batching.py
@@ -0,0 +1,133 @@
+"""Bounded greedy decoder batches with independent padding and stop conditions."""
+# Local modifications (2026-10-05): bounded chunk batching and visible speaker labels.
+
+
+from __future__ import annotations
+
+from typing import cast
+
+import mlx.core as mx
+import numpy as np
+
+from .audio import SAMPLE_RATE, compute_features
+from .generate import (
+    GenerationConfig,
+    GenerationResult,
+    _detect_repetition,
+    _finalize_generation_result,
+    _periodic_eval,
+    resolve_max_new_tokens,
+)
+from .model import Qwen3ASRModel
+from .tokenizer import Tokenizer
+
+
+def generate_batch(
+    model: Qwen3ASRModel,
+    prompts: list[list[int]],
+    audio_features: list[mx.array],
+    configs: list[GenerationConfig],
+) -> list[GenerationResult]:
+    """Decode independent prompts together, preserving each row's token budget.
+
+    Prompts are left-padded. Padding keys are masked throughout decoding and
+    each row retains its unpadded rotary positions. Finished rows do not append
+    tokens while the remaining rows finish; all rows use one bounded KV cache.
+    """
+    if not prompts or len(prompts) != len(audio_features) or len(prompts) != len(configs):
+        raise ValueError("prompts, audio_features and configs must have equal nonzero lengths")
+    if any(not p for p in prompts):
+        raise ValueError("prompts must not be empty")
+    if any(c.max_new_tokens < 0 or c.temperature != 0 for c in configs):
+        raise ValueError("batch decoding requires nonnegative budgets and greedy temperature=0")
+    generated: list[list[int]] = [[] for _ in prompts]
+    if not any(c.max_new_tokens for c in configs):
+        return [_finalize_generation_result(t, c) for t, c in zip(generated, configs, strict=True)]
+
+    lengths = mx.array([len(p) for p in prompts], dtype=mx.int32)
+    width = max(len(p) for p in prompts)
+    padding = width - lengths
+    input_ids = mx.array([[0] * (width - len(p)) + p for p in prompts])
+    positions = mx.maximum(mx.arange(width)[None, :] - padding[:, None], 0)
+    position_ids = mx.stack([positions] * 3, axis=1)
+    valid_keys = mx.arange(width)[None, :] >= padding[:, None]
+    # Padding queries must have a finite softmax too: let them attend their
+    # causal prefix, while real queries can only attend real prompt keys.
+    causal = mx.arange(width)[:, None] >= mx.arange(width)[None, :]
+    allowed = causal[None, :, :] & (
+        valid_keys[:, None, :] | ~valid_keys[:, :, None]
+    )
+    max_audio = max(a.shape[1] for a in audio_features)
+    features = mx.concatenate(
+        [mx.pad(a, [(0, 0), (0, max_audio - a.shape[1]), (0, 0)]) for a in audio_features],
+        axis=0,
+    )
+    embeds = model._embed_tokens(input_ids)
+    embeds = model._inject_audio_features(embeds, features, input_ids == model.audio_token_id)
+    mask = mx.where(allowed[:, None, :, :], 0, -float("inf")).astype(embeds.dtype)
+    budget = max(c.max_new_tokens for c in configs)
+    cache = model.create_cache(max_seq_len=width + budget)
+    hidden = model.model(
+        inputs_embeds=embeds, position_ids=position_ids, attention_mask=mask, cache=cache
+    )
+    logits = model.lm_head(hidden[:, -1:, :])
+    active = [c.max_new_tokens > 0 for c in configs]
+
+    for step in range(budget):
+        tokens = cast(list[int], mx.argmax(logits[:, -1, :], axis=-1).tolist())
+        for row, (token, config) in enumerate(zip(tokens, configs, strict=True)):
+            if not active[row]:
+                continue
+            generated[row].append(token)
+            active[row] = (
+                token not in config.eos_token_ids
+                and len(generated[row]) < config.max_new_tokens
+                and not _detect_repetition(generated[row])
+            )
+        if not any(active):
+            break
+        next_ids = mx.array([[t] for t in tokens])
+        next_positions = (lengths + step)[:, None, None]
+        next_positions = mx.broadcast_to(next_positions, (len(prompts), 3, 1))
+        keys = mx.concatenate(
+            [valid_keys, mx.ones((len(prompts), step + 1), dtype=mx.bool_)], axis=1
+        )
+        decode_mask = mx.where(keys[:, None, None, :], 0, -float("inf")).astype(embeds.dtype)
+        hidden = model.model(
+            inputs_embeds=model._embed_tokens(next_ids, validate_input_ids=False),
+            position_ids=next_positions,
+            attention_mask=decode_mask,
+            cache=cache,
+        )
+        logits = model.lm_head(hidden)
+        _periodic_eval(cache, step + 1, configs[0].eval_interval)
+
+    return [_finalize_generation_result(t, c) for t, c in zip(generated, configs, strict=True)]
+
+
+def decode_chunk_batch(
+    model: Qwen3ASRModel,
+    tokenizer: Tokenizer,
+    audios: list[np.ndarray],
+    *,
+    context: str,
+    language: str | None,
+    dtype: mx.Dtype,
+    max_new_tokens: int | None,
+) -> list[GenerationResult]:
+    """Encode chunks independently, then batch their variable-length text decodes."""
+    prompts = []
+    features = []
+    configs = []
+    for audio in audios:
+        mel, lens = compute_features(audio)
+        encoded, _ = model.audio_tower(mel.astype(dtype), lens)
+        mx.eval(encoded)
+        features.append(encoded)
+        prompts.append(tokenizer.build_prompt_tokens(
+            n_audio_tokens=encoded.shape[1], language=language, context=context
+        ))
+        configs.append(GenerationConfig(max_new_tokens=resolve_max_new_tokens(
+            max_new_tokens, audio_duration_sec=len(audio) / SAMPLE_RATE
+        )))
+    return generate_batch(model, prompts, features, configs)
