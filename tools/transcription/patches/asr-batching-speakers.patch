index 0000000..041255a
--- /dev/null
+++ b/mlx_qwen3_asr/diarization_embeddings.py
@@ -0,0 +1,113 @@
+"""Share WeSpeaker audio features across the speaker masks of each window.
+
+Pyannote's generic pipeline evaluates the waveform once per local speaker.
+WeSpeaker supports all masks in one forward pass: its expensive audio network
+does not depend on the masks, which are applied only at statistics pooling.
+The adaptation is local to a supported pipeline instance; other backends and
+training continue to use pyannote's original implementation.
+"""
+# Local modifications (2026-10-05): reuse speaker-independent audio features.
+
+from __future__ import annotations
+
+import math
+import warnings
+from collections.abc import Iterator, Sequence
+from typing import Any, Callable
+
+import numpy as np
+
+
+def install_shared_embeddings(pipeline: Any) -> None:
+    """Adapt an inference pipeline with the supported native WeSpeaker backend."""
+    embedding = getattr(pipeline, "_embedding", None)
+    if embedding is None:
+        return
+    try:
+        from pyannote.audio.models.embedding.wespeaker import BaseWeSpeakerResNet
+        from pyannote.audio.pipelines.speaker_verification import (
+            PyannoteAudioPretrainedSpeakerEmbedding,
+        )
+    except ImportError:
+        return
+
+    if (
+        not isinstance(embedding, PyannoteAudioPretrainedSpeakerEmbedding)
+        or not isinstance(embedding.model_, BaseWeSpeakerResNet)
+        or isinstance(pipeline.get_embeddings, _SharedEmbeddings)
+    ):
+        return
+    pipeline.get_embeddings = _SharedEmbeddings(pipeline, pipeline.get_embeddings)
+
+
+class _SharedEmbeddings:
+    """A per-pipeline adapter for pyannote's embedding extension point."""
+
+    def __init__(self, pipeline: Any, original: Callable[..., np.ndarray]):
+        self.pipeline = pipeline
+        self.original = original
+
+    def __call__(
+        self,
+        file: Any,
+        binary_segmentations: Any,
+        exclude_overlap: bool = False,
+        hook: Callable[..., Any] | None = None,
+    ) -> np.ndarray:
+        pipeline = self.pipeline
+        if pipeline.training:
+            return self.original(
+                file, binary_segmentations, exclude_overlap=exclude_overlap, hook=hook
+            )
+        from pyannote.audio.pipelines.speaker_diarization import batchify
+
+        embedding = pipeline._embedding
+        num_chunks, num_frames, num_speakers = binary_segmentations.data.shape
+        duration = binary_segmentations.sliding_window.duration
+        min_frames = (
+            math.ceil(
+                num_frames * embedding.min_num_samples / (duration * embedding.sample_rate)
+            )
+            if exclude_overlap
+            else -1
+        )
+        batch_size = pipeline.embedding_batch_size
+        total = math.ceil(num_chunks / batch_size)
+        if hook is not None:
+            hook("embeddings", None, total=total, completed=0)
+        outputs: list[np.ndarray] = []
+
+        def iter_windows() -> Iterator[tuple[Any, np.ndarray]]:
+            for chunk, masks in binary_segmentations:
+                waveform, _ = pipeline._audio.crop(file, chunk, mode="pad")
+                clean = (
+                    masks * (np.sum(masks, axis=1, keepdims=True) < 2)
+                    if exclude_overlap
+                    else masks
+                )
+                masks = np.nan_to_num(masks, nan=0.0).astype(np.float32)
+                clean = np.nan_to_num(clean, nan=0.0).astype(np.float32)
+                selected = np.where((clean.sum(axis=0) > min_frames)[None, :], clean, masks)
+                yield waveform, selected.T
+
+        for completed, batch in enumerate(batchify(iter_windows(), batch_size=batch_size), 1):
+            waveforms, weights = zip(*(item for item in batch if item is not None), strict=True)
+            result = _encode_masks(embedding, waveforms, weights)
+            outputs.append(result)
+            if hook is not None:
+                hook("embeddings", result, total=total, completed=completed)
+        if not outputs:
+            return np.empty((0, num_speakers, embedding.dimension), dtype=np.float32)
+        return np.concatenate(outputs, axis=0)
+
+
+def _encode_masks(
+    embedding: Any, waveforms: Sequence[Any], masks: Sequence[np.ndarray]
+) -> np.ndarray:
+    import torch
+
+    with torch.inference_mode(), warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        audio_batch = torch.stack(waveforms).to(embedding.device)
+        mask_batch = torch.from_numpy(np.stack(masks)).to(embedding.device)
+        return embedding.model_(audio_batch, weights=mask_batch).cpu().numpy()
